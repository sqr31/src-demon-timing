# Supabase project (Project Settings -> API). Server-side only: never expose the
# service role key to the browser, and do not prefix it with NEXT_PUBLIC_.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Secret used to sign the session cookie. Generate one with:
#   openssl rand -base64 32
SESSION_SECRET=

# Single shared password for /admin (build step 5).
ADMIN_PASSWORD=
